#include<string>
#include<algorithm>
using namespace std;
int main(){
    string s;
    cin >> s;
    string n = "";
    for(int i = 0 ; i < s.length(); i+=2){
        n += s[i];
        
    }
    sort(n.begin(),n.end());
    int newInd = 0;
    for(int i = 0 ; i < s.length(); i++){
        if(i % 2 == 0){
            cout << n[newInd];
            newInd++;
        }else{
            cout << s[i] ;
        }
    }
    
    cout << endl;
    
    return 0;
    
}
